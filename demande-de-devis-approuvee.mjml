    <style type="text/css">


    @media only screen and (max-width: 480px) {
        table.mj-full-width-mobile {
            width: 100% !important;
        }

        td.mj-full-width-mobile {
            width: auto !important;
        }
    }

    </style>
    <style type="text/css">
    ul {
        padding-left: 15px;
    }

    @media all and (max-width: 767px) {
        body {
            padding: 0 20px !important;
        }

        .mj-container {
            padding: 0 10px !important;
        }

        .header-wrap > table > tbody > tr > td {
            padding-bottom: 32px !important;
            padding-top: 20px !important;
        }

        .logo > td > table > tbody > tr > td {
            width: 150px !important;
        }

        .intro-wrap div {
            font-size: 14px !important;
            line-height: 20px !important;
        }

        .header-img > table > tbody > tr > td {
            padding-bottom: 20px !important;
            padding-top: 20px !important;
            padding-bottom: 0 !important;
        }

        .content-title div {
            font-size: 18px !important;
            line-height: 22px !important;
        }

        .content-title {
            padding-left: 32px !important;
            padding-right: 32px !important;
            padding-bottom: 20px !important;
        }

        .content-text {
            padding-left: 32px !important;
            padding-right: 32px !important;
        }

        .content-wrap > table > tbody > tr > td {
            padding-bottom: 30px !important;
            padding-top: 32px !important;
        }

        .contact-wrap > table > tbody > tr > td {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        .contact-wrap td {
            border: 0 !important;
        }

        .content-wrap.content-text-info > table > tbody > tr > td {
            padding-top: 0 !important;
            padding-bottom: 32px !important;
        }

        .divider > table > tbody > tr > td {
            padding-left: 8px !important;
            padding-right: 8px !important;
            padding-bottom: 15px !important;
            padding-top: 15px !important;
        }

        .footer-logo-wrap .mj-column-per-33 {
            width: 33% !important;
            text-align: center !important;
        }

        .footer-logo-wrap td {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }
    }
    </style>

</head>
<body style="word-spacing:normal;background-color:#F3F3F3;">


<div
    style="background-color:#F3F3F3;"
>
    <!-- Header -->

    <!--[if mso | IE]>
    <table align="center" border="0" cellpadding="0" cellspacing="0" class="header-wrap-outlook" role="presentation"
           style="width:660px;" width="660" bgcolor="#F3F3F3">
        <tr>
            <td style="line-height:0px;font-size:0px;mso-line-height-rule:exactly;"><![endif]-->


    <div class="header-wrap" style="background:#F3F3F3;background-color:#F3F3F3;margin:0px auto;max-width:660px;">

        <table
            align="center" border="0" cellpadding="0" cellspacing="0" role="presentation"
            style="background:#F3F3F3;background-color:#F3F3F3;width:100%;"
        >
            <tbody>
            <tr>
                <td
                    style="direction:ltr;font-size:0px;padding:20px 0;padding-bottom:40px;padding-top:50px;text-align:center;"
                >
                    <!--[if mso | IE]>
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                        <tr>
                            <td class="" style="vertical-align:top;width:660px;"><![endif]-->

                    <div
                        class="mj-column-per-100 mj-outlook-group-fix"
                        style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"
                    >

                        <table
                            border="0" cellpadding="0" cellspacing="0" role="presentation" style="vertical-align:top;"
                            width="100%"
                        >
                            <tbody>

                            <tr>
                                <td
                                    align="center" class="logo"
                                    style="font-size:0px;padding:10px 25px;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0;word-break:break-word;"
                                >

                                    <table
                                        border="0" cellpadding="0" cellspacing="0" role="presentation"
                                        style="border-collapse:collapse;border-spacing:0px;"
                                    >
                                        <tbody>
                                        <tr>
                                            <td style="width:200px;">

                                                <img
                                                    {{if logo_width}}
                                                        width="{{var logo_width}}"
                                                    {{else}}
                                                        width="180"
                                                    {{/if}}

                                                    {{if logo_height}}
                                                        height="{{var logo_height}}"
                                                    {{/if}}
                                                    src="{{var logo_url}}"
                                                    alt="{{var logo_alt}}"
                                                    width="200"
                                                />

                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>

                                </td>
                            </tr>

                            </tbody>
                        </table>

                    </div>

                    <!--[if mso | IE]></td></tr></table><![endif]-->
                </td>
            </tr>
            </tbody>
        </table>

    </div>


    <!--[if mso | IE]></td></tr></table><![endif]-->

      <!-- Content Text -->
      
      <!--[if mso | IE]><table align="center" border="0" cellpadding="0" cellspacing="0" class="content-wrap-outlook" role="presentation" style="width:660px;" width="660" bgcolor="#ffffff" ><tr><td style="line-height:0px;font-size:0px;mso-line-height-rule:exactly;"><![endif]-->
    
      
      <div  class="content-wrap" style="background:#ffffff;background-color:#ffffff;margin:0px auto;max-width:660px;">
        
        <table
           align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="background:#ffffff;background-color:#ffffff;width:100%;"
        >
          <tbody>
            <tr>
              <td
                 style="direction:ltr;font-size:0px;padding:20px 0;padding-bottom:25px;padding-top:40px;text-align:center;"
              >
                <!--[if mso | IE]><table role="presentation" border="0" cellpadding="0" cellspacing="0"><tr><td class="" style="vertical-align:top;width:660px;" ><![endif]-->
            
      <div
         class="mj-column-per-100 mj-outlook-group-fix" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"
      >
        
      <table
         border="0" cellpadding="0" cellspacing="0" role="presentation" style="vertical-align:top;" width="100%"
      >
        <tbody>
          
              <tr>
                <td
                   align="center" class="content-title" style="font-size:0px;padding:10px 25px;padding-top:0;padding-right:50px;padding-bottom:20px;padding-left:50px;word-break:break-word;"
                >
                  
      <div
         style="font-family:Roboto, Arial, sans-serif;font-size:20px;font-weight:600;line-height:1;text-align:center;color:#000000;"
      >Terminez votre achat et avancez sur votre projet</div>
    
                </td>
              </tr>
            
              <tr>
                <td
                   align="left" class="content-text" style="font-size:0px;padding:10px 25px;padding-top:0;padding-right:50px;padding-bottom:0;padding-left:50px;word-break:break-word;"
                >
                  
      <div
         style="font-family:Roboto, Arial, sans-serif;font-size:16px;font-weight:400;line-height:25px;text-align:left;color:#000000;"
      ><p>Bonjour {{var ruleQuote.getCustomerFirstname()}}, </p>
            <p>On a remarqué que votre panier sur notre site LeMAGASINduBTP.com renferme des trésors qui ne demandent qu'à rejoindre votre boîte à outils pour réaliser des merveilles sur votre chantier.</p>
            <p>Jetez un coup d'œil rapide à ce que vous avez laissé derrière vous :</p></div>
    
                </td>
              </tr>
            
              <tr>
                <td
                   align="left" style="font-size:16px; text-align:left;padding:10px 25px;word-break:break-word;"
                >
                  
                  {{layout
                      handle="amasty_acart_email"
                      quoteId=$quoteId
                      quoteCustomerId=$quoteCustomerId
                      mode=list
                      showImage=yes
                      showConfigurableImage=no
                      showPrice=yes
                      priceFormat=excludeTax
                      showDescription=no
                      optionList=yes
                      showSKU=no
                      showQty=no
                  }}
    
                </td>
              </tr>
            
              <tr>
                <td
                   align="left" class="content-text" style="font-size:0px;padding:10px 25px;padding-top:0;padding-right:50px;padding-bottom:0;padding-left:50px;word-break:break-word;"
                >
                  
      <div
         style="font-family:Roboto, Arial, sans-serif;font-size:16px;font-weight:400;line-height:25px;text-align:left;color:#000000;"
      ><p style="text-align:center;">
            <table class="acart-table">
                <tr>
                    <td class="acart-label">{{trans "Subtotal"}}:</td>
                    <td class="acart-value">
                        {{var formattedSubtotal | raw}}
                    </td>
                </tr>
                {{if quote.getTax()}}
                    <tr>
                        <td class="acart-label">{{trans "Tax"}}:</td>
                        <td class="acart-value">{{var formattedQuoteTax | raw}}</td>
                    </tr>
                {{/if}}
                {{if quote.getDiscount()}}
                    <tr>
                        <td class="acart-label">{{trans "Discount"}}:</td>
                        <td class="acart-value">{{var formattedDiscount | raw}}</td>
                    </tr>
                {{/if}}
                <tr class="acart-total">
                    <td class="acart-label">{{trans "Total"}}:</td>
                    <td class="acart-value">{{var formattedGrandTotal | raw}}</td>
                </tr>
            </table>
            <p></div>
    
                </td>
              </tr>
            
              <tr>
                <td
                   align="center" vertical-align="middle" style="font-size:0px;padding:10px 25px;word-break:break-word;"
                >
                  
      <table
         border="0" cellpadding="0" cellspacing="0" role="presentation" style="border-collapse:separate;line-height:100%;"
      >
        <tbody>
          <tr>
            <td
               align="center" bgcolor="#ffffff" role="presentation" style="border:1px solid #00add5;border-radius:4px;cursor:auto;mso-padding-alt:10px 25px;background:#ffffff;" valign="middle"
            >
              <a
                 href="https://www.lemagasindubtp.com/" style="display:inline-block;background:#ffffff;color:#BDBDBD;font-family:Roboto, Arial, sans-serif;font-size:16px;font-weight:600;line-height:120%;margin:0;text-decoration:none;text-transform:none;padding:10px 25px;mso-padding-alt:0px;border-radius:4px;" target="_blank"
              >
                Acheter maintenant
              </a>
            </td>
          </tr>
        </tbody>
      </table>
    
                </td>
              </tr>
            
        </tbody>
      </table>
    
      </div>
    
          <!--[if mso | IE]></td></tr></table><![endif]-->
              </td>
            </tr>
          </tbody>
        </table>
        
      </div>

      <!--[if mso | IE]></td></tr></table><![endif]-->
    
