    <style type="text/css">
    @media only screen and (min-width: 480px) {
        .mj-column-per-100 {
            width: 100% !important;
            max-width: 100%;
        }

        .mj-column-per-33 {
            width: 33% !important;
            max-width: 33%;
        }
    }
    </style>
    <style media="screen and (min-width:480px)">
    .moz-text-html .mj-column-per-100 {
        width: 100% !important;
        max-width: 100%;
    }

    .moz-text-html .mj-column-per-33 {
        width: 33% !important;
        max-width: 33%;
    }
