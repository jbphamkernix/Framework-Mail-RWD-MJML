         class="mj-column-per-100 mj-outlook-group-fix" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:middle;width:100%;"
      >
        
      <table
         border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%"
      >
        <tbody>
          <tr>
            <td  style="vertical-align:middle;padding:0;">
              
      <table
         border="0" cellpadding="0" cellspacing="0" role="presentation" style="" width="100%"
      >
        <tbody>
          
              <tr>
                <td
                   align="center" class="content-text" style="font-size:0px;padding:0;padding-top:0;padding-right:0;padding-bottom:0;padding-left:0;word-break:break-word;"
                >
                  
      <div
         style="font-family:Roboto, Arial, sans-serif;font-size:13px;font-weight:400;line-height:25px;text-align:center;color:#000000;"
      ><span style="display:inline-block; vertical-alignt: middle; padding: 0 10px">
              <img width="100px" src="{{config path="web/secure/base_url"}}media/wysiwyg/email/client.png" /><br>
              <span>Service client 24/7</span>
            </span>
             <span style="display:inline-block; vertical-alignt: middle; padding: 0 10px">
              <img width="100px" src="{{config path="web/secure/base_url"}}media/wysiwyg/email/sav.png" /><br>
              <span>SAV 100% garanti</span>
            </span>
             <span style="display:inline-block; vertical-alignt: middle; padding: 0 10px">
              <img width="100px" src="{{config path="web/secure/base_url"}}media/wysiwyg/email/expedition.png" /><br>
              <span>Expédition rapide</span>
            </span>
             <span style="display:inline-block; vertical-alignt: middle; padding: 0 10px">
